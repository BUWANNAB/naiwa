<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="MilkCream" Color="#FFFCF1"/>
  <SolidColorBrush x:Key="MilkBorder" Color="#EAD69B"/>
  <SolidColorBrush x:Key="MilkInk" Color="#604A25"/>
  <SolidColorBrush x:Key="MilkMuted" Color="#9B8356"/>
  <Style x:Key="MilkSection" TargetType="MenuItem">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="MenuItem">
        <TextBlock Text="{TemplateBinding Header}" FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{StaticResource MilkMuted}" Margin="12,8,8,5"/>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
      <Border Background="#EDE0BA" Height="1" Margin="10,7"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource MilkInk}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
    <Setter Property="Padding" Value="11,7"/>
    <Setter Property="Margin" Value="2,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Grid>
        <Border x:Name="ItemShell" Background="{TemplateBinding Background}"
                CornerRadius="11" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            <TextBlock x:Name="Check" Grid.Column="2" Text="✓" Foreground="#69824A" FontSize="15"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" FontSize="21" Foreground="#A88C4D"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-6"
               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Border Background="{StaticResource MilkCream}" BorderBrush="{StaticResource MilkBorder}"
                  BorderThickness="1" CornerRadius="17" Padding="6" Margin="4" MinWidth="172">
            <Border.Effect><DropShadowEffect Color="#6D521D" BlurRadius="9" ShadowDepth="2" Opacity="0.14"/></Border.Effect>
            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
          <Setter TargetName="ItemShell" Property="Background" Value="#EAF0D9"/>
        </Trigger>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="ItemShell" Property="Background" Value="#FFF0B5"/>
          <Setter TargetName="ItemShell" Property="BorderBrush" Value="#F0D47F"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemShell" Property="BorderBrush" Value="#C5AC65"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemShell" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MilkContextMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
    <Setter Property="Foreground" Value="{StaticResource MilkInk}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="284"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border x:Name="MenuShell" Background="{StaticResource MilkCream}" CornerRadius="21"
              BorderBrush="{StaticResource MilkBorder}" BorderThickness="1" Padding="7" Margin="8">
        <Border.Effect><DropShadowEffect Color="#6D521D" BlurRadius="13" ShadowDepth="3" Opacity="0.19"/></Border.Effect>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="#FFF2C4" CornerRadius="15" Padding="12,9" Margin="2,2,2,6">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Image Source="pack://application:,,,/Assets/idle/00.png" Width="35" Height="44" Stretch="Uniform"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="奶蛙的小窝" FontSize="16" FontWeight="SemiBold" Foreground="#624817"/>
                <TextBlock Text="拖一拖就笑 · 双击来打拳" FontSize="10" Foreground="#A38A51" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
